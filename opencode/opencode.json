{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "figma-desktop": {
        "type": "remote",
        "url": "http://127.0.0.1:3845/mcp",
        "disabled": true
      },
      "playwright": {
        "type": "local",
        "command": [
          "npx",
          "@playwright/mcp@latest"
        ]
      }
    }
  },
  "websearch": {
    "provider": "random"
  }
}
